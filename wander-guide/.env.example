# HTTP port for the Wander Guide PWA (keep separate from Chrono on 3000)
PORT=4173

# Public https origin when the app is served on a live domain (enables HSTS)
# PUBLIC_ORIGIN=https://wander.example.com

# Force HSTS even in development
# FORCE_HSTS=1

# Log coarse ~1 km lookup grids to stdout (never exact GPS). Off by default.
# WANDER_LOG_LOOKUPS=1

# NODE_ENV=production
