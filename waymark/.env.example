NODE_ENV=production
SESSION_SECRET=replace-with-long-random-string
PUBLIC_ORIGIN=https://waymark.example.com
ALLOWED_ORIGINS=https://waymark.example.com
TRUST_PROXY=1
FORCE_SECURE_COOKIES=1
FORCE_HSTS=1
PORT=3000
# Bind all interfaces so Cursor Cloud preview can reach the app.
# Behind a reverse proxy in production you may set 127.0.0.1 instead.
BIND_HOST=0.0.0.0
DB_FILE=data/waymark.db
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=10
MAX_BODY_BYTES=1000000
COOKIE_ONLY_AUTH=1
# Browser Maps JavaScript API key. Restrict it by HTTP referrer in Google Cloud.
# Without it, Waymark shows OpenStreetMap streets and still opens Google Maps links.
# GOOGLE_MAPS_API_KEY=
# DEMO_PASSWORD=waymark-demo-1
