NODE_ENV=production
SESSION_SECRET=replace-with-long-random-string
PUBLIC_ORIGIN=https://pinpoint.example.com
ALLOWED_ORIGINS=https://pinpoint.example.com
TRUST_PROXY=1
FORCE_SECURE_COOKIES=1
FORCE_HSTS=1
PORT=3010
BIND_HOST=127.0.0.1
DB_FILE=data/pinpoint.db
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=10
MAX_BODY_BYTES=1000000
COOKIE_ONLY_AUTH=1
# DEMO_PASSWORD=pinpoint-demo-1
