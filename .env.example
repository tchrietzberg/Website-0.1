# --- Required before public deploy ---
NODE_ENV=production
SESSION_SECRET=replace-with-long-random-string
# Comma-separated browser origins allowed for CSRF/OAuth (include https://your.domain)
ALLOWED_ORIGINS=https://billing.example.com
PUBLIC_ORIGIN=https://billing.example.com
# Set when TLS is terminated by a reverse proxy
TRUST_PROXY=1
FORCE_SECURE_COOKIES=1
FORCE_HSTS=1

# --- App ---
PORT=3000
# BIND_HOST=127.0.0.1
DB_FILE=data/billing.db
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=10
MAX_BODY_BYTES=1000000

# Demo seed password only (never use default in production)
# DEMO_PASSWORD=demo-change-me

# --- Email (invite, password reset, magic-link login) ---
# Without Resend/SMTP, messages are logged to data/mail-outbox.jsonl only (not delivered).
# Prefer Resend API, or any SMTP relay. Admins can also save these in Settings → Email.
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=billing@yourfirm.com
# AUTH_INVITE_TTL_HOURS=48
# AUTH_RESET_TTL_MINUTES=60
# AUTH_MAGIC_TTL_MINUTES=15
# AUTH_EMAIL_MAX_ATTEMPTS=10

# Microsoft OneDrive (one Azure app for the product)
MS_CLIENT_ID=
# MS_TENANT_ID=common
# MS_CLIENT_SECRET=
