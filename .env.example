# --- Required before public deploy (live domain) ---
NODE_ENV=production
SESSION_SECRET=replace-with-long-random-string
# Canonical https origin of the live site (also enables live-domain hardening)
PUBLIC_ORIGIN=https://billing.example.com
# Comma-separated browser origins allowed for CSRF/OAuth (include PUBLIC_ORIGIN)
ALLOWED_ORIGINS=https://billing.example.com
# Optional alias used for invite/reset email links (defaults to PUBLIC_ORIGIN)
# APP_BASE_URL=https://billing.example.com
# Set when TLS is terminated by a reverse proxy
TRUST_PROXY=1
FORCE_SECURE_COOKIES=1
FORCE_HSTS=1
# Optional HSTS preload once HTTPS is confirmed on all subdomains
# HSTS_PRELOAD=1
# Cookie-only sessions (no Bearer / sessionStorage token). Default on when
# NODE_ENV=production or PUBLIC_ORIGIN is https. Set 0 only for legacy clients.
# COOKIE_ONLY_AUTH=1
# Strict Origin/Referer checks on mutating API calls. Default on with live domain.
# STRICT_ORIGIN_CHECK=1

# --- App ---
PORT=3000
# BIND_HOST=127.0.0.1
DB_FILE=data/billing.db
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=10
MAX_BODY_BYTES=1000000
# MFA_CHALLENGE_TTL_MS=300000
# MFA_CHALLENGE_MAX_ATTEMPTS=5

# Demo seed password only (never use default in production)
# DEMO_PASSWORD=demo-change-me

# --- Email (deferred until a live domain) ---
# Outbound email is OFF by default. Invite / reset use copyable links instead.
# When the firm domain is live, set OUTBOUND_EMAIL=1 and configure Resend or SMTP.
# OUTBOUND_EMAIL=0
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=billing@yourfirm.com
# AUTH_INVITE_TTL_HOURS=48
# AUTH_RESET_TTL_MINUTES=60
# AUTH_MAGIC_TTL_MINUTES=15
# AUTH_EMAIL_MAX_ATTEMPTS=10

# Intake phone webhook (Twilio or similar posts JSON { transcript, from })
# INTAKE_PHONE_WEBHOOK_SECRET=replace-with-long-random-string
# Outbound click-to-call (website button / Dial a test call)
# Prefer Settings → Phone dialing in the app. Env vars override saved settings.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# TWILIO_FROM_NUMBER=+15555550100
# TWILIO_STUB=1

# Microsoft OneDrive (one Azure app for the product)
MS_CLIENT_ID=
# MS_TENANT_ID=common
# MS_CLIENT_SECRET=
